# Copy to .env. Everything is optional: with nothing set, the example runs offline.
# `python -m hemisphere_harness` lists the providers you can name below.

# --- Right hemisphere (the Master) ------------------------------------------------------
# Setting RIGHT_MODEL is what switches the right hemisphere from the offline script to a
# live LLM. Pick a strong, long-context model: this is the part that holds the whole picture.
#
#   RIGHT_PROVIDER      endpoint                                 key variable
#   openai (default)    https://api.openai.com/v1                OPENAI_API_KEY
#   nvidia              https://integrate.api.nvidia.com/v1      NVIDIA_API_KEY
#   xai, grok           https://api.x.ai/v1                      XAI_API_KEY
#   openrouter          https://openrouter.ai/api/v1             OPENROUTER_API_KEY
#   ollama              http://localhost:11434/v1                none
#   lmstudio            http://localhost:1234/v1                 none
#   vllm                http://localhost:8000/v1                 none
#   llamacpp            http://localhost:8080/v1                 none
#   openai-compatible   set RIGHT_BASE_URL                       RIGHT_API_KEY, if needed
RIGHT_PROVIDER=openai
RIGHT_MODEL=

# The key for the provider you chose. A provider's key is sent only to its own endpoint.
OPENAI_API_KEY=
# NVIDIA_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=

# Override the provider's endpoint, for a proxy or a self-hosted server:
# RIGHT_BASE_URL=http://localhost:8000/v1
# Override the provider's key variable. This one is sent to whichever endpoint is in use:
# RIGHT_API_KEY=

# RIGHT_TIMEOUT_S=120
# Unset by default, because some models reject the parameter:
# RIGHT_TEMPERATURE=0.2
# true also sends response_format={"type": "json_object"}. Helps small local models:
# RIGHT_JSON_MODE=false

# --- Left hemisphere (the Emissary) -----------------------------------------------------
#   LEFT_PROVIDER       what it is                                         needs
#   auto (default)      jev if JEV_API_KEY is set, otherwise mock
#   jev                 TypeSafe AI's hosted Jev                           JEV_API_KEY
#   ollama              a decision model served by Ollama, locally         LEFT_MODEL
#   systemone           any other server implementing /v1/systemone        LEFT_BASE_URL, LEFT_MODEL
#   llm-experimental    EXPERIMENTAL: a chat model, not calibrated         LEFT_MODEL
#   mock                offline stand-in for development
# LEFT_PROVIDER=auto

# TypeSafe's hosted Jev. Keys: https://console.typesafe.ai/keys
JEV_API_KEY=
# The client appends /v1/systemone to the base URL:
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_S=10
# TypeSafe's own names are accepted too: TYPESAFE_API_KEY, TYPESAFE_BASE_URL,
# TYPESAFE_DEFAULT_MODEL.

# A local decision model through Ollama. `ollama show <model>` must list "decision".
# LEFT_PROVIDER=ollama
# LEFT_MODEL=tev1

# For ollama, systemone and llm-experimental:
# LEFT_BASE_URL=http://localhost:11434
# LEFT_API_KEY=
# The first call may have to load the model, so the default is generous:
# LEFT_TIMEOUT_S=120
# llm-experimental only. "none" stops a reasoning model thinking before it answers;
# "omit" leaves the parameter out for servers that reject it:
# LEFT_REASONING_EFFORT=none

# --- The loop ---------------------------------------------------------------------------
# Minimum probability of the left's pick for the left to commit on its own:
# HARNESS_COMMIT_THRESHOLD=0.8
# Policy gate: at or above this, an option is allowed without sign-off:
# HARNESS_PERMIT_YES_THRESHOLD=0.7
# Policy gate: at or below this, only a human can approve an option:
# HARNESS_PERMIT_NO_THRESHOLD=0.3
# HARNESS_MAX_STEPS=6
# Operator policy in plain language. Leave unset to disable the gate:
# HARNESS_POLICY=Refunds above $500 need human sign-off.
